{
  "name": "solar-selector",
  "version": "1.0.0",
  "description": "Solar Pear: pair the right solar panels with your roof and the right PV controller with your panels.",
  "homepage": "https://solarpear.echook.uk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GryphonR/Solar-Pear.git"
  },
  "bugs": {
    "url": "https://github.com/GryphonR/Solar-Pear/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "verify:panels:review": "node verification_scripts/panel-review.js",
    "verify:controllers:review": "node verification_scripts/controller-review.js",
    "verify:panels:pricing": "node verification_scripts/panel-pricing-scan.js",
    "verify:controllers:pricing": "node verification_scripts/controller-pricing-scan.js"
  },
  "keywords": [
    "solar",
    "pv",
    "mppt",
    "solar-panels",
    "charge-controller",
    "inverter",
    "off-grid"
  ],
  "author": "Rowan",
  "license": "GPL-3.0-only",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
